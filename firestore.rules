rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Booking form submissions — public write, no client reads
    match /bookings/{docId} {
      allow create: if isValidBooking(request.resource.data);
      allow read, update, delete: if false;
    }

    // Newsletter subscribers — public write, no client reads
    match /subscribers/{docId} {
      allow create: if isValidSubscriber(request.resource.data);
      allow read, update, delete: if false;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }

  function isValidBooking(data) {
    return data.keys().hasAll(['firstName', 'lastName', 'email', 'submittedAt'])
      && data.firstName is string && data.firstName.size() > 0 && data.firstName.size() <= 100
      && data.lastName is string && data.lastName.size() > 0 && data.lastName.size() <= 100
      && data.email is string && data.email.size() > 0 && data.email.size() <= 200;
  }

  function isValidSubscriber(data) {
    return data.keys().hasAll(['name', 'email', 'subscribedAt'])
      && data.name is string && data.name.size() > 0 && data.name.size() <= 100
      && data.email is string && data.email.size() > 0 && data.email.size() <= 200;
  }
}
